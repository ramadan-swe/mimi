# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI API
OPENAI_API_KEY=sk-your-openai-key-here

# Redis (for Celery)
REDIS_URL=redis://redis:6379/0

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-key-here
DEFAULT_FROM_EMAIL=noreply@carrental.com

# Veriff API
VERIFF_API_KEY=your-veriff-api-key
VERIFF_API_SECRET=your-veriff-secret

# Paymob
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_SECRET_KEY=your-paymob-secret
PAYMOB_PUBLIC_KEY=your-paymob-public-key
INTEGRATION_ID=your-paymob-integration-id

# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=config/serviceAccountKey.json

# Media Files
MEDIA_ROOT=media/
MEDIA_URL=/media/
