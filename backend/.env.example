# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI API
OPENAI_API_KEY=sk-your-openai-key-here

# SMS.to API
SMS_API_KEY=your-sms-to-api-key

# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-key-here
DEFAULT_FROM_EMAIL=noreply@carrental.com

# Veriff API
VERIFF_API_KEY=your-veriff-api-key
VERIFF_API_SECRET=your-veriff-secret

# Paymob
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_SECRET_KEY=your-paymob-secret

# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=config/serviceAccountKey.json

# Media Files
MEDIA_ROOT=media/
MEDIA_URL=/media/
